# CodeQuest Bob IBM Cloud configuration template
#
# Copy this file to .env.local for local development.
# Never commit .env.local, API keys, service credentials, tokens, or JSON credential files.
#
# Important:
# - Do not prefix secret values with VITE_.
# - VITE_* values are exposed to the browser by Vite.
# - Real IBM API calls should go through a local backend/serverless proxy.

# IBM Cloud IAM
IBM_CLOUD_API_KEY=

# watsonx.ai / Watson Machine Learning
# For the hackathon resources Somi saw, WML and watsonx.ai Studio were in Dallas/us-south.
WATSONX_PROJECT_ID=
WATSONX_SPACE_ID=
WATSONX_REGION=us-south
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Watson Natural Language Understanding
NLU_API_KEY=
NLU_URL=
NLU_VERSION=2022-04-07

# Watson Text to Speech
TTS_API_KEY=
TTS_URL=
TTS_VOICE=en-US_AllisonV3Voice

# Watson Speech to Text
STT_API_KEY=
STT_URL=
STT_MODEL=en-US_BroadbandModel

# IBM Cloudant
CLOUDANT_URL=
CLOUDANT_DB=codequest_skill_boosts

# watsonx Orchestrate
ORCHESTRATE_URL=

# Optional: raises GitHub Search API rate limits for Skill Boost Radar.
GITHUB_TOKEN=

# App runtime mode
IBM_INTEGRATION_MODE=mock
